rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // Función para obtener el rol del usuario
    function isAdmin() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin';
    }
    
    function isMaestro() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'maestro';
    }
    
    function isAdminOrMaestro() {
      return isAdmin() || isMaestro();
    }

    match /users/{userId} {
      allow read: if request.auth != null;
      allow list: if request.auth != null && isAdmin();
      allow get: if request.auth != null && (request.auth.uid == userId || isAdmin());
      allow create: if request.auth != null && request.auth.uid == userId;
      allow update: if request.auth != null && (request.auth.uid == userId 
                    && !request.resource.data.diff(resource.data).affectedKeys().hasAny(['role']) 
                    || isAdmin());
    }

    match /courses/{courseId} {
      allow read, list, get: if request.auth != null; 
      allow write: if request.auth != null && isAdmin();
      
      match /modules/{moduleId} {
        allow read, list, get: if request.auth != null;
        allow write: if request.auth != null && isAdmin();
      }
    }

    // Compatibilidad para consultas a nivel raíz de módulos
    match /modules/{moduleId} {
      allow read, list, get: if request.auth != null;
      allow write: if request.auth != null && isAdmin();
    }

    match /lessons/{lessonId} {
      allow read, list, get: if request.auth != null;
      allow write: if request.auth != null && isAdmin();
      
      match /comments/{commentId} {
        allow read: if request.auth != null;
        allow create: if request.auth != null 
                      && isAdminOrMaestro()
                      && request.resource.data.userId == request.auth.uid;
        allow update, delete: if request.auth != null 
                              && (isAdminOrMaestro() || resource.data.userId == request.auth.uid);
      }
    }

    // Colección raíz para cuestionarios de las lecciones
    match /quizzes/{quizId} {
      allow read, list, get: if request.auth != null;
      allow write: if request.auth != null && isAdmin();
    }

    match /dataUser/{userId} {
      allow read: if request.auth != null && isMaestro();
      allow create, update, write: if request.auth != null && (request.auth.uid == userId || isAdmin());
    }

    match /user_courses/{courseId} {
      allow read, write: if request.auth != null;
    }

    match /userProgress/{progressId} {
      allow read, write: if request.auth != null;
      allow list: if request.auth != null && isAdmin();
      allow get: if request.auth != null;
    }

    match /notifications/{notificationId} {
      allow read: if request.auth != null 
                  && (request.auth.uid == resource.data.userId || isAdminOrMaestro());
      allow create: if request.auth != null;
      allow update, delete: if request.auth != null 
                  && (request.auth.uid == resource.data.userId || isAdminOrMaestro());
    }

    // Reglas para tracking de video educativo
    match /videoProgress/{documentId} {
      // Permitir leer y listar si el documento pertenece al usuario (o en consultas filtradas por su userId)
      allow read, list, get: if request.auth != null 
                              && (resource == null || resource.data.userId == request.auth.uid || isAdmin());
      // Permitir escribir su propio progreso de video
      allow write: if request.auth != null 
                    && (request.resource.data.userId == request.auth.uid || isAdmin());
    }

    // Reglas para configuración del sistema (solo admin)
    match /systemConfig/{configId} {
      allow read, get: if request.auth != null && isAdmin();
      allow write, create, update: if request.auth != null && isAdmin();
    }
  }
}
