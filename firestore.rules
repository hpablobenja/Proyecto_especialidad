rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // Función para obtener el rol del usuario
    function isAdmin() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin';
    }
    
    function isMaestro() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'maestro';
    }
    
    function isAdminOrMaestro() {
      return isAdmin() || isMaestro();
    }

    match /users/{userId} {
      allow read: if request.auth != null;
      allow list: if request.auth != null && isAdmin();
      allow get: if request.auth != null && (request.auth.uid == userId || isAdmin());
      allow create: if request.auth != null && request.auth.uid == userId;
      allow update: if request.auth != null && (request.auth.uid == userId 
                    && !request.resource.data.diff(resource.data).affectedKeys().hasAny(['role']) 
                    || isAdmin());
    }

    match /courses/{courseId} {
      allow read: if request.auth != null; 
      allow write: if request.auth != null && isAdmin();
      
      match /modules/{moduleId} {
        allow read: if request.auth != null;
        allow write: if request.auth != null && isAdmin();
        allow list: if request.auth != null;
        allow get: if request.auth != null;

        match /lessons/{lessonId} {
          allow list: if request.auth != null;
          allow get: if request.auth != null;
          allow read: if request.auth != null;
          allow write: if request.auth != null && isAdmin();
        }
      }
    }

    // Compatibilidad para consultas a nivel raíz
    match /modules/{moduleId} {
      allow read: if request.auth != null;
      allow write: if request.auth != null && isAdmin();
    }

    match /lessons/{lessonId} {
      allow read: if request.auth != null;
      allow write: if request.auth != null && isAdmin();
    }

    match /lecciones/{leccionId} {
      allow read: if request.auth != null;
      allow create, update: if request.auth != null && isAdmin()
                            && request.resource.data.keys().hasAll(['courseId', 'moduleId']);
      allow delete: if request.auth != null && isAdmin();
    }

    match /quizzes/{quizId} {
      allow read: if request.auth != null;
      allow create, update: if request.auth != null && isAdmin()
                            && request.resource.data.keys().hasAll(['lessonId', 'courseId', 'moduleId']);
      allow delete: if request.auth != null && isAdmin();
    }

    match /dataUser/{userId} {
    	allow read: if request.auth != null && isMaestro();
      allow create, update, write: if request.auth != null && (request.auth.uid == userId || isAdmin());
    }
		match /user_courses/{courseId} {
      allow read, write: if request.auth != null;
    }
    match /userProgress/{progressId} {
      allow read, write: if request.auth != null;
      allow list: if request.auth != null && isAdmin();
      allow get: if request.auth != null;
    }

    match /notifications/{notificationId} {
      allow read: if request.auth != null 
                  && (request.auth.uid == resource.data.userId || isAdminOrMaestro());
      allow create: if request.auth != null;
      allow update, delete: if request.auth != null 
                  && (request.auth.uid == resource.data.userId || isAdminOrMaestro());
    }
  }
}

